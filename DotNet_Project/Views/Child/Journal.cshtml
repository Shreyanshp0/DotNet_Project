@{ ViewData["Title"] = "Daily journal"; }
@section Styles { <link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" /> }
<div class="activity-page journal-page"><div class="container activity-container"><a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to my space</a><div class="activity-heading text-center"><span class="eyebrow">A place to reflect</span><h1>My daily journal</h1><p>There is no pressure to share anything you do not want to. You can choose “Prefer not to answer”.</p></div><div class="privacy-notice"><i class="bi bi-eye"></i><p class="mb-0"><strong>A note about privacy:</strong> Journal entries you submit are visible to your parent or guardian.</p></div><form id="journalForm" class="activity-card journal-card" novalidate><div class="journal-prompt"><label for="bestPart">1. What was the best part of your day?</label><textarea id="bestPart" name="BestPart" rows="3" placeholder="A moment you enjoyed, big or small..."></textarea><label class="prefer-option"><input type="checkbox" data-prefer="bestPart"> Prefer not to answer</label></div><div class="journal-prompt"><label for="difficult">2. Was anything difficult today?</label><textarea id="difficult" name="Difficult" rows="3" placeholder="You can leave this blank if you would rather not say."></textarea><label class="prefer-option"><input type="checkbox" data-prefer="difficult"> Prefer not to answer</label></div><div class="journal-prompt"><label for="dayDescription">3. How would you describe your day?</label><textarea id="dayDescription" name="DayDescription" rows="3" placeholder="A few words, a sentence, or nothing at all..."></textarea><label class="prefer-option"><input type="checkbox" data-prefer="dayDescription"> Prefer not to answer</label></div><div class="journal-prompt"><label for="helpNeeded">4. Is there anything you would like help with?</label><textarea id="helpNeeded" name="HelpNeeded" rows="3" placeholder="You can ask for support without sharing details."></textarea><label class="prefer-option"><input type="checkbox" data-prefer="helpNeeded"> Prefer not to answer</label></div><div class="emotion-section"><label class="form-label">Optional: choose an emotion for today</label><div class="emotion-picker"><label><input type="radio" name="Emotion" value="Calm"><span>🌿 Calm</span></label><label><input type="radio" name="Emotion" value="Happy"><span>☀️ Happy</span></label><label><input type="radio" name="Emotion" value="Tired"><span>🌙 Tired</span></label><label><input type="radio" name="Emotion" value="Worried"><span>🌧️ Worried</span></label></div></div><button class="btn btn-primary mt-4" type="submit" id="journalSubmit">Submit today's reflection <i class="bi bi-arrow-right ms-2"></i></button><div class="activity-success d-none mt-4" id="journalSuccess" role="status"><i class="bi bi-check-circle-fill"></i><div><strong>Reflection submitted.</strong><p class="mb-0">Your parent can see this entry. You can write another reflection tomorrow.</p></div></div></form><div class="text-center mt-4"><a class="text-link" asp-action="JournalHistory">View previous journal entries <i class="bi bi-arrow-right"></i></a></div></div></div>
@section Scripts { <script src="~/js/activities.js" asp-append-version="true"></script> }