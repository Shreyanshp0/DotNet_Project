@{
    ViewData["Title"] = "Breathing Exercises";
}
@section Styles {
    <link rel="stylesheet" href="~/css/relaxation.css" asp-append-version="true" />
}
<div class="relax-page" id="breathingApp">
    <div class="container relax-container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <a asp-action="Relaxation" id="breathingExitBtn" class="back-link"><i class="bi bi-arrow-left"></i> Exit to Relaxation Corner</a>
            <span class="small text-muted" id="breathingSessionTime">1:00 remaining</span>
        </div>

        <div class="relax-shell mt-3">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <span class="eyebrow">Breathing exercise</span>
                    <h1 class="h2 mb-1">Slow, steady breaths</h1>
                    <p class="text-muted small mb-0">Follow the circle as it expands and settles.</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <div>
                        <label for="breathingModeSelect" class="visually-hidden">Breathing style</label>
                        <select id="breathingModeSelect" class="form-select form-select-sm">
                            <option value="box">Box Breathing (4-4-4-4)</option>
                            <option value="gentle">Gentle Breathing (No holds)</option>
                        </select>
                    </div>
                    <div>
                        <label for="breathingDurationSelect" class="visually-hidden">Session duration</label>
                        <select id="breathingDurationSelect" class="form-select form-select-sm">
                            <option value="60">1 minute</option>
                            <option value="120">2 minutes</option>
                            <option value="180">3 minutes</option>
                            <option value="300">5 minutes</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="breathing-stage-wrap">
                <div class="breathing-circle" id="breathingCircle" aria-live="polite">
                    <span class="breathing-stage-label" id="breathingStageLabel">Ready</span>
                    <span class="breathing-countdown" id="breathingCountdown">4</span>
                </div>
            </div>

            <div class="progress mb-4" style="height: 8px;">
                <div class="progress-bar bg-blue" id="breathingProgressBar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
            </div>

            <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
                <button type="button" class="btn btn-primary" id="breathingStartBtn"><i class="bi bi-play-fill me-1"></i> Start</button>
                <button type="button" class="btn btn-outline-secondary" id="breathingPauseBtn" disabled>Pause</button>
                <button type="button" class="btn btn-ghost" id="breathingResetBtn">Reset</button>
            </div>

            <div class="alert alert-success d-none" id="breathingCompleteBanner">
                <i class="bi bi-check-circle-fill me-2"></i>
                Nice job taking a moment for yourself! You can restart anytime or head back to the Relaxation Corner.
            </div>

            <div class="relax-safety-note">
                <i class="bi bi-shield-check"></i>
                <p class="mb-0">Breathe naturally and comfortably. You never have to hold your breath—switch to <strong>Gentle Breathing (No holds)</strong> anytime, and stop right away if you feel dizzy, uncomfortable, or anxious.</p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/relaxation.js" asp-append-version="true"></script>
}
