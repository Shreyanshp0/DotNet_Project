@{ ViewData["Title"] = "MindCare Buddy"; }
@section Styles { <link rel="stylesheet" href="~/css/buddy.css" asp-append-version="true" /> }
<div class="buddy-page">
    <div class="container buddy-container">
        <div class="buddy-toolbar">
            <a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to my space</a>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="clearConversation"><i class="bi bi-arrow-counterclockwise me-1"></i> Clear conversation</button>
        </div>
        <div class="buddy-shell">
            <aside class="buddy-intro">
                <div class="buddy-intro-header">
                    <div class="buddy-avatar buddy-avatar-large"><i class="bi bi-stars"></i></div>
                    <span class="eyebrow">A friendly listening space</span>
                </div>
                <h1>Meet MindCare Buddy</h1>
                <p>Sometimes it helps to talk things through. I can listen, help you name a feeling, or just keep you company for a little while.</p>
                <div class="buddy-online"><span></span> Available to chat</div>
                <div class="buddy-help-card">
                    <i class="bi bi-heart-pulse"></i>
                    <div>
                        <strong>Need a real person?</strong>
                        <p>Talk to a trusted adult if something feels serious or unsafe.</p>
                        <a href="mailto:hello@mindcare.example">Get help <i class="bi bi-arrow-up-right"></i></a>
                    </div>
                </div>
            </aside>
            <section class="buddy-chat" aria-label="MindCare Buddy chat">
                <header class="buddy-chat-header">
                    <div class="buddy-avatar"><i class="bi bi-stars"></i></div>
                    <div>
                        <h2>MindCare Buddy</h2>
                        <span><i class="bi bi-circle-fill"></i> Online</span>
                    </div>
                </header>
                <div class="buddy-messages" id="buddyMessages" aria-live="polite" aria-label="Conversation">
                    <div class="buddy-message buddy-message-bot">
                        <div class="message-avatar"><i class="bi bi-stars"></i></div>
                        <div>
                            <div class="message-bubble">Hi! I’m MindCare Buddy. I’m happy to listen. How are you feeling today?</div>
                            <time>Just now</time>
                        </div>
                    </div>
                </div>
                <div class="buddy-typing d-none" id="buddyTyping"><span></span><span></span><span></span><small>Buddy is thinking...</small></div>
                <div class="buddy-prompts" id="buddyPrompts">
                    <span class="prompt-label">You could say...</span>
                    <button type="button" class="prompt-chip">I am feeling sad.</button>
                    <button type="button" class="prompt-chip">I am stressed about school.</button>
                    <button type="button" class="prompt-chip">I want to talk about my friends.</button>
                    <button type="button" class="prompt-chip">I am feeling happy.</button>
                    <button type="button" class="prompt-chip">I just want to chat.</button>
                </div>
                <form class="buddy-composer" id="buddyForm" data-endpoint="/Chat/SendMessage">
                    <label class="visually-hidden" for="buddyInput">Message MindCare Buddy</label>
                    <textarea id="buddyInput" name="Message" rows="1" maxlength="500" placeholder="Type a message..." autocomplete="off"></textarea>
                    <input type="hidden" name="ConversationId" id="conversationId">
                    <button class="buddy-send" type="submit" aria-label="Send message"><i class="bi bi-send-fill"></i></button>
                </form>
                <div class="buddy-safety">
                    <i class="bi bi-shield-check"></i>
                    <span>MindCare Buddy is an AI support companion, not a therapist. If something serious is troubling you, please talk to a trusted adult.</span>
                    <a href="mailto:hello@mindcare.example">Get Help</a>
                </div>
            </section>
        </div>
    </div>
</div>
@section Scripts { <script src="~/js/buddy.js" asp-append-version="true"></script> }
