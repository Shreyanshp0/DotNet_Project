@model DotNet_Project.DTOs.ChildDashboardDto
@using DotNet_Project.Models
@{
    ViewData["Title"] = "Child space";
    ViewData["PageClass"] = "dashboard-page";
    var childName = Model?.ChildName ?? "Alex";
    var todayStr = DateTime.UtcNow.ToString("dddd, MMMM dd");
    var moodCount = Model?.TodayMoodCount ?? 0;
    var journalDone = Model?.JournalSubmittedToday ?? false;
    var progressCount = Model?.DailyProgressCount ?? 0;
    var lastAssessment = Model?.LastAssessmentDate ?? "None yet";
    var recentRelaxation = ViewBag.RecentRelaxation as List<ExerciseSession> ?? new();
    var supportRequests = ViewBag.SupportRequests as List<SupportRequest> ?? new();
    var initials = string.Join("", childName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper();
    if (string.IsNullOrEmpty(initials)) initials = "C";
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" />
}
<div class="dashboard-wrap">
    <div class="container">
        <div class="dashboard-top">
            <div>
                <span class="eyebrow">@todayStr</span>
                <h1>Hi, @childName <span class="wave">👋</span></h1>
                <p class="text-muted mb-0">A small check-in can make a big difference.</p>
            </div>
            <div class="profile-chip">
                <span class="avatar avatar-blue">@initials</span>
                <span class="d-none d-sm-block"><strong>@childName</strong><small>Child space</small></span>
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>

        <section class="daily-wellbeing">
            <div class="section-heading dashboard-section-heading">
                <div>
                    <span class="eyebrow">@todayStr</span>
                    <h2>My Daily Well-being</h2>
                    <p>Complete your daily mood and journal when it feels right. The questionnaire is separate and does not count toward your daily progress.</p>
                </div>
                <div class="daily-progress-badge">
                    <strong id="dailyProgressCount">@progressCount of 2</strong>
                    <span>daily activities</span>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-4">
                    <article class="dashboard-card daily-activity-card">
                        <span class="activity-card-icon blue"><i class="bi bi-emoji-smile"></i></span>
                        <span class="card-kicker">Daily Mood Check-in</span>
                        <h3>How are you feeling?</h3>
                        <p class="text-muted">You have checked in <strong id="todayMoodCount">@moodCount @(moodCount == 1 ? "time" : "times")</strong> today.</p>
                        @if (moodCount > 0)
                        {
                            <span class="activity-status status-complete"><i class="bi bi-check-circle-fill"></i> Completed today</span>
                            <a class="btn btn-primary w-100 mt-4" asp-action="MoodCheckIn">Check in again <i class="bi bi-arrow-right ms-2"></i></a>
                        }
                        else
                        {
                            <span class="activity-status status-pending"><i class="bi bi-circle"></i> Not completed today</span>
                            <a class="btn btn-primary w-100 mt-4" asp-action="MoodCheckIn">Check in now <i class="bi bi-arrow-right ms-2"></i></a>
                        }
                    </article>
                </div>

                <div class="col-lg-4">
                    <article class="dashboard-card daily-activity-card">
                        <span class="activity-card-icon lavender"><i class="bi bi-clipboard2-heart"></i></span>
                        <span class="card-kicker">Well-being Assessment</span>
                        <h3>Reflect at your pace</h3>
                        <p class="text-muted">Last completed <strong>@lastAssessment</strong>.</p>
                        <span class="activity-status status-neutral"><i class="bi bi-clock"></i> Available</span>
                        <a class="btn btn-outline-primary w-100 mt-4" asp-controller="Assessment" asp-action="Index">Start assessment <i class="bi bi-arrow-right ms-2"></i></a>
                    </article>
                </div>

                <div class="col-lg-4">
                    <article class="dashboard-card daily-activity-card">
                        <span class="activity-card-icon mint"><i class="bi bi-journal-heart"></i></span>
                        <span class="card-kicker">My Daily Journal</span>
                        <h3>How was your day?</h3>
                        <p class="text-muted">A few words can help you notice what matters.</p>
                        @if (journalDone)
                        {
                            <span class="activity-status status-complete"><i class="bi bi-check-circle-fill"></i> Completed today</span>
                            <a class="btn btn-outline-primary w-100 mt-4" asp-action="JournalHistory">View entry <i class="bi bi-arrow-right ms-2"></i></a>
                        }
                        else
                        {
                            <span class="activity-status status-pending"><i class="bi bi-circle"></i> Not completed today</span>
                            <a class="btn btn-outline-primary w-100 mt-4" asp-action="Journal">Open journal <i class="bi bi-arrow-right ms-2"></i></a>
                        }
                    </article>
                </div>
            </div>
        </section>

        <div class="dashboard-card buddy-dashboard-card mt-4">
            <div class="buddy-dashboard-icon"><i class="bi bi-stars"></i></div>
            <div>
                <span class="card-kicker">MindCare Buddy</span>
                <h3>Need someone to talk to?</h3>
                <p class="text-muted mb-3">MindCare Buddy is here to listen.</p>
                <a class="btn btn-primary" asp-action="Buddy">Talk to Buddy <i class="bi bi-arrow-right ms-2"></i></a>
            </div>
        </div>

        <div class="dashboard-card mt-4" style="background: #f4fbf8; border-color: #d4efe4;">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <span class="card-kicker">Relaxation Corner</span>
                    <h3>Take a quiet break anytime</h3>
                    <p class="text-muted mb-3">Try a slow breathing circle, a 5-4-3-2-1 grounding guide, or kind affirmations whenever you want to pause.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary btn-sm" asp-action="Relaxation">Open Relaxation Corner <i class="bi bi-arrow-right ms-1"></i></a>
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Breathing">Breathing</a>
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Grounding">5-4-3-2-1 Grounding</a>
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Affirmations">Affirmations</a>
                    </div>
                </div>
                @if (recentRelaxation.Count > 0)
                {
                    <div class="bg-white rounded-4 border p-3" style="min-width: 220px;">
                        <span class="small fw-bold text-muted d-block mb-2">Recently visited</span>
                        @foreach (var item in recentRelaxation)
                        {
                            <div class="small d-flex justify-content-between gap-3 py-1 border-top">
                                <span>@item.ExerciseType</span>
                                <span class="text-muted">@item.CompletedAt.ToLocalTime().ToString("MMM dd")</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="dashboard-card mt-4" id="supportRequestSection" style="background: #f8faff; border-color: #dbe7fd;">
            <div class="row g-4 align-items-start">
                <div class="col-lg-7">
                    <span class="card-kicker">Support request</span>
                    <h3>Would you like to talk to someone?</h3>
                    <p class="text-muted mb-3">You don't have to handle everything alone. You can let your parent or trusted adult know when you need support.</p>

                    @if (TempData["SupportSuccess"] is string supOk)
                    {
                        <div class="alert alert-success">@supOk</div>
                    }
                    @if (TempData["SupportError"] is string supErr)
                    {
                        <div class="alert alert-danger">@supErr</div>
                    }

                    <form asp-action="CreateSupportRequest" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="supportReason" class="form-label small fw-semibold">What would you like to share? (optional)</label>
                            <select id="supportReason" name="reason" class="form-select">
                                <option value="I feel upset.">I feel upset.</option>
                                <option value="Something is worrying me.">Something is worrying me.</option>
                                <option value="I am having a difficult day.">I am having a difficult day.</option>
                                <option value="I need help with something.">I need help with something.</option>
                                <option value="I would prefer not to say." selected>I would prefer not to say.</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="supportMessage" class="form-label small fw-semibold">Short note for your parent (optional)</label>
                            <textarea id="supportMessage" name="message" class="form-control" rows="2" maxlength="500" placeholder="You can leave this blank if you just want them to check in with you."></textarea>
                        </div>
                        <p class="small text-muted mb-3">
                            <i class="bi bi-info-circle me-1"></i>
                            Submitting a request shares the selected reason and any optional message with your linked parent on their dashboard.
                        </p>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-chat-heart me-1"></i> Send support request
                        </button>
                    </form>
                </div>

                <div class="col-lg-5">
                    <div class="bg-white rounded-4 border p-3">
                        <span class="card-kicker">Your requests</span>
                        <h4 class="h6 mb-3">Recent status</h4>
                        @if (supportRequests.Count == 0)
                        {
                            <p class="text-muted small mb-0">You haven't sent a support request yet.</p>
                        }
                        else
                        {
                            @foreach (var req in supportRequests.Take(4))
                            {
                                var pillStyle = req.Status switch
                                {
                                    SupportRequestStatus.Resolved => "background:#e8f6f0; color:#2f7d65;",
                                    SupportRequestStatus.Acknowledged => "background:#eef4fe; color:var(--blue-dark);",
                                    _ => "background:#fff7e6; color:#9a6700;"
                                };
                                <div class="py-2 border-top">
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <strong class="small">@req.Reason</strong>
                                        <span class="status-pill" style="@pillStyle">@req.Status</span>
                                    </div>
                                    <small class="text-muted d-block">@req.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</small>
                                    @if (!string.IsNullOrWhiteSpace(req.ParentResponse))
                                    {
                                        <small class="d-block mt-1 text-dark">Parent note: @req.ParentResponse</small>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-2">
            <div class="col-lg-8">
                <div class="dashboard-card assessment-cta">
                    <div>
                        <span class="card-kicker">A little support</span>
                        <h3>You are building a healthy habit.</h3>
                        <p>Daily activities are for noticing how you feel, not for getting perfect answers.</p>
                        <a class="text-link" href="mailto:hello@mindcare.example">Need help or want to talk? <i class="bi bi-arrow-right"></i></a>
                    </div>
                    <div class="cta-icon"><i class="bi bi-chat-heart"></i></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="tip-card h-100">
                    <i class="bi bi-lightbulb-fill"></i>
                    <div>
                        <strong>Today's little tip</strong>
                        <p class="mb-0">A few slow breaths can help your body feel calmer.</p>
                        <a class="support-link mt-2" asp-action="JournalHistory">View journal history</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
