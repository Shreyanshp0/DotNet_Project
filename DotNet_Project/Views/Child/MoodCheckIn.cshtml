@{ ViewData["Title"] = "Daily mood check-in"; }
@section Styles { <link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" /> }
<div class="activity-page"><div class="container activity-container"><a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to my space</a><div class="activity-heading text-center"><span class="eyebrow">A moment for you</span><h1>How are you feeling right now?</h1><p>There is no right or wrong answer. You can check in more than once today.</p></div><div class="activity-card mood-check-card"><div class="mood-option-grid"><button type="button" class="activity-mood-option" data-mood="Great" data-emoji="😄"><span>😄</span><strong>Great</strong><small>Feeling bright</small></button><button type="button" class="activity-mood-option" data-mood="Good" data-emoji="😊"><span>😊</span><strong>Good</strong><small>Feeling okay</small></button><button type="button" class="activity-mood-option" data-mood="Okay" data-emoji="😐"><span>😐</span><strong>Okay</strong><small>Taking it easy</small></button><button type="button" class="activity-mood-option" data-mood="Low" data-emoji="😟"><span>😟</span><strong>Low</strong><small>Not my best</small></button><button type="button" class="activity-mood-option" data-mood="Worried" data-emoji="😢"><span>😢</span><strong>Worried</strong><small>Need some care</small></button></div><div class="mood-follow-up d-none" id="moodFollowUp"><div class="selected-mood" id="selectedMood"></div><label class="form-label" for="moodReason">Would you like to say why? <span class="text-muted fw-normal">(optional)</span></label><textarea class="form-control" id="moodReason" rows="3" maxlength="300" placeholder="You can share as much or as little as you like."></textarea><div class="d-flex flex-wrap gap-2 mt-3"><button class="btn btn-primary" type="button" id="saveMoodButton">Save check-in</button><button class="btn btn-outline-secondary" type="button" id="skipMoodButton">Skip explanation</button></div></div><div class="activity-success d-none" id="moodSuccess" role="status"><i class="bi bi-check-circle-fill"></i><div><strong>Check-in added.</strong><p class="mb-0">Your mood has been recorded without replacing earlier check-ins.</p></div></div></div><div class="activity-card mt-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><span class="card-kicker">Today</span><h3>Previous check-ins</h3></div><span class="activity-count" id="moodCount">2 entries</span></div><div id="moodEntries"><div class="entry-row"><span class="entry-emoji">🙂</span><div><strong>Good</strong><small>Feeling okay about school</small></div><time>9:12 AM</time></div><div class="entry-row"><span class="entry-emoji">😐</span><div><strong>Okay</strong><small>No explanation shared</small></div><time>1:40 PM</time></div></div><div class="empty-state d-none" id="moodEmpty"><i class="bi bi-cloud-sun"></i><p>No check-ins yet today. This is a safe place to start.</p></div></div></div></div>
@section Scripts { <script src="~/js/activities.js" asp-append-version="true"></script> }