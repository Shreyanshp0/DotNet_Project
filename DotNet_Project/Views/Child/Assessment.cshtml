@{ ViewData["Title"] = "Wellbeing assessment"; }
@section Styles { <link rel="stylesheet" href="~/css/assessment.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" /> }
<div class="assessment-page"><div class="container"><div class="assessment-header"><a class="back-link" asp-controller="Child" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to my space</a><div class="assessment-title"><span class="eyebrow">A quiet moment for you</span><h1>Wellbeing check-in</h1><p>Answer 10 gentle questions about how you have felt recently.</p></div><div class="assessment-progress"><div class="d-flex justify-content-between small fw-semibold"><span id="assessmentStepLabel">Question 1 of 10</span><span id="assessmentProgressText">10%</span></div><div class="progress"><div class="progress-bar" id="assessmentProgressBar" style="width:10%"></div></div></div></div><form id="childAssessmentForm" novalidate><div id="assessmentQuestions"><div class="question-card" data-question="1"><span class="question-category">01 · Emotional well-being</span><h2>Do you feel happy most of the time?</h2><p class="question-helper">Think about your usual days, not only today.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q1" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="2"><span class="question-category">02 · Emotional well-being</span><h2>Do you feel able to talk about your feelings?</h2><p class="question-helper">This can be with someone you trust.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q2" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="3"><span class="question-category">03 · Academic stress</span><h2>Do you feel stressed about schoolwork?</h2><p class="question-helper">Include homework, tests, and deadlines.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q3" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="4"><span class="question-category">04 · Academic stress</span><h2>Do you feel able to focus when you study?</h2><p class="question-helper">Think about what helps or makes focusing harder.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q4" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="5"><span class="question-category">05 · Social relationships</span><h2>Do you feel comfortable talking to your friends?</h2><p class="question-helper">Think about sharing ideas or asking for help.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q5" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="6"><span class="question-category">06 · Social relationships</span><h2>Do you feel included by other children?</h2><p class="question-helper">At school, activities, or your neighborhood.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q6" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="7"><span class="question-category">07 · Sleep and lifestyle</span><h2>Do you get enough sleep?</h2><p class="question-helper">Think about whether you wake up feeling rested.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q7" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="8"><span class="question-category">08 · Sleep and lifestyle</span><h2>Do you make time for things you enjoy?</h2><p class="question-helper">Hobbies, play, rest, and family time all count.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q8" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="9"><span class="question-category">09 · Self-confidence</span><h2>Do you feel confident about yourself?</h2><p class="question-helper">Confidence can look different each day.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q9" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="10"><span class="question-category">10 · Self-confidence</span><h2>Do you feel proud when you learn something new?</h2><p class="question-helper">Big achievements and tiny wins both matter.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q10" value="@answer" required><span>@answer</span></label> }</div></div></div><div class="assessment-review d-none" id="assessmentReview"><span class="eyebrow">Almost there</span><h2>Review your answers</h2><p class="text-muted">You can go back if you want to change anything.</p><div id="reviewAnswers"></div></div><div class="assessment-actions"><button type="button" class="btn btn-outline-secondary" id="childPrevious" disabled><i class="bi bi-arrow-left me-2"></i> Previous</button><button type="button" class="btn btn-primary" id="childNext">Next question <i class="bi bi-arrow-right ms-2"></i></button><button type="button" class="btn btn-primary d-none" id="childReview">Review answers <i class="bi bi-list-check ms-2"></i></button><button type="submit" class="btn btn-primary d-none" id="childSubmit">Submit assessment <i class="bi bi-check2 ms-2"></i></button></div><p class="assessment-note"><i class="bi bi-shield-check"></i> Your answers are private and will be visible to your parent when submitted.</p></form></div></div>
@section Scripts { <script src="~/js/activities.js" asp-append-version="true"></script> }