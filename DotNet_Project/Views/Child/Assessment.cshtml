@model List<DotNet_Project.DTOs.AssessmentQuestionItem>
@{
    ViewData["Title"] = "Wellbeing assessment";
    var questions = (Model != null && Model.Count > 0) ? Model : new List<DotNet_Project.DTOs.AssessmentQuestionItem>
    {
        new() { QuestionId = 1, Category = "Emotional well-being", QuestionText = "Do you feel happy most of the time?", HelperText = "Think about your usual days, not only today." },
        new() { QuestionId = 2, Category = "Emotional well-being", QuestionText = "Do you feel able to talk about your feelings?", HelperText = "This can be with someone you trust." },
        new() { QuestionId = 3, Category = "Academic stress", QuestionText = "Do you feel stressed about schoolwork?", HelperText = "Include homework, tests, and deadlines." },
        new() { QuestionId = 4, Category = "Academic stress", QuestionText = "Do you feel able to focus when you study?", HelperText = "Think about what helps or makes focusing harder." },
        new() { QuestionId = 5, Category = "Social relationships", QuestionText = "Do you feel comfortable talking to your friends?", HelperText = "Think about sharing ideas or asking for help." },
        new() { QuestionId = 6, Category = "Social relationships", QuestionText = "Do you feel included by other children?", HelperText = "At school, activities, or your neighborhood." },
        new() { QuestionId = 7, Category = "Sleep and lifestyle", QuestionText = "Do you get enough sleep?", HelperText = "Think about whether you wake up feeling rested." },
        new() { QuestionId = 8, Category = "Sleep and lifestyle", QuestionText = "Do you make time for things you enjoy?", HelperText = "Hobbies, play, rest, and family time all count." },
        new() { QuestionId = 9, Category = "Self-confidence", QuestionText = "Do you feel confident about yourself?", HelperText = "Confidence can look different each day." },
        new() { QuestionId = 10, Category = "Self-confidence", QuestionText = "Do you feel proud when you learn something new?", HelperText = "Big achievements and tiny wins both matter." }
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/assessment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" />
}
<div class="assessment-page">
    <div class="container">
        <div class="assessment-header">
            <a class="back-link" asp-controller="Child" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to my space</a>
            <div class="assessment-title">
                <span class="eyebrow"><i class="bi bi-stars text-primary me-1"></i> AI-Guided Assessment</span>
                <h1>Wellbeing check-in</h1>
                <p>Answer 10 gentle questions curated by AI about how you have felt recently.</p>
            </div>
            <div class="assessment-progress">
                <div class="d-flex justify-content-between small fw-semibold">
                    <span id="assessmentStepLabel">Question 1 of @questions.Count</span>
                    <span id="assessmentProgressText">10%</span>
                </div>
                <div class="progress">
                    <div class="progress-bar" id="assessmentProgressBar" style="width:10%"></div>
                </div>
            </div>
        </div>

        <form id="childAssessmentForm" novalidate>
            <div id="assessmentQuestions">
                @for (int i = 0; i < questions.Count; i++)
                {
                    var q = questions[i];
                    var isFirst = i == 0;
                    var options = q.Options != null && q.Options.Length > 0 ? q.Options : ["Never", "Rarely", "Sometimes", "Often", "Always"];

                    <div class="question-card @(isFirst ? "" : "d-none")" data-question="@q.QuestionId">
                        <span class="question-category">@($"{q.QuestionId:D2} · {q.Category}")</span>
                        <h2>@q.QuestionText</h2>
                        @if (!string.IsNullOrEmpty(q.HelperText))
                        {
                            <p class="question-helper">@q.HelperText</p>
                        }
                        <div class="answer-grid">
                            @foreach (var answer in options)
                            {
                                <label>
                                    <input type="radio" name="@($"q{q.QuestionId}")" value="@answer" required>
                                    <span>@answer</span>
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="assessment-review d-none" id="assessmentReview">
                <span class="eyebrow">Almost there</span>
                <h2>Review your answers</h2>
                <p class="text-muted">You can go back if you want to change anything before generating your parent report.</p>
                <div id="reviewAnswers"></div>
            </div>

            <div class="assessment-actions">
                <button type="button" class="btn btn-outline-secondary" id="childPrevious" disabled>
                    <i class="bi bi-arrow-left me-2"></i> Previous
                </button>
                <button type="button" class="btn btn-primary" id="childNext">
                    Next question <i class="bi bi-arrow-right ms-2"></i>
                </button>
                <button type="button" class="btn btn-primary d-none" id="childReview">
                    Review answers <i class="bi bi-list-check ms-2"></i>
                </button>
                <button type="submit" class="btn btn-primary d-none" id="childSubmit">
                    Submit to AI &amp; Generate Report <i class="bi bi-stars ms-2"></i>
                </button>
            </div>

            <p class="assessment-note">
                <i class="bi bi-shield-check"></i> Your answers are analyzed securely to create an encouraging summary for your parent.
            </p>
        </form>
    </div>
</div>
@section Scripts {
    <script src="~/js/activities.js" asp-append-version="true"></script>
}
