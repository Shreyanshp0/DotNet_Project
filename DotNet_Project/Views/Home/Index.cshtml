@{ ViewData["Title"] = "A kinder way to understand wellbeing"; }

<section class="hero-section" id="top">
    <div class="container position-relative">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="eyebrow"><i class="bi bi-stars"></i> Supporting growing minds</span>
                <h1>Every child deserves to feel <em>happy, safe</em> and understood.</h1>
                <p class="hero-lead">MindCare helps children check in with themselves and gives parents thoughtful, easy-to-understand insights to support everyday wellbeing.</p>
                <div class="d-flex flex-wrap gap-3"><a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Get started <i class="bi bi-arrow-up-right ms-2"></i></a><a class="btn btn-outline-secondary btn-lg" href="#how-it-works">See how it works <i class="bi bi-play-circle ms-2"></i></a></div>
                <div class="trust-row"><span><i class="bi bi-shield-check"></i> Private by design</span><span><i class="bi bi-heart"></i> Built with care</span></div>
            </div>
            <div class="col-lg-5"><div class="hero-art"><div class="art-orb orb-one"></div><div class="art-orb orb-two"></div><div class="hero-card card-main"><div class="d-flex justify-content-between align-items-center"><span class="small fw-semibold text-muted">Today's check-in</span><i class="bi bi-three-dots"></i></div><div class="mood-face">☺</div><h5>How are you feeling?</h5><p class="small text-muted mb-0">There are no wrong answers.</p><div class="mood-dots"><span>😄</span><span>🙂</span><span>😐</span><span>🙁</span><span>😟</span></div></div><div class="hero-card card-float"><span class="icon-circle mint"><i class="bi bi-graph-up-arrow"></i></span><div><strong>Wellbeing is growing</strong><small>Small steps matter</small></div></div><div class="hero-sparkle"><i class="bi bi-sun-fill"></i></div></div></div>
        </div>
    </div>
</section>
<section class="section-pad bg-white" id="features"><div class="container"><div class="section-heading text-center"><span class="eyebrow">A little support goes a long way</span><h2>Tools for brighter days</h2><p>Simple, thoughtful features that make wellbeing part of the everyday conversation.</p></div><div class="row g-4 mt-2"><div class="col-md-6 col-lg-3"><div class="feature-card"><span class="icon-box lavender"><i class="bi bi-clipboard2-heart"></i></span><h5>Wellbeing assessments</h5><p>Friendly check-ins help children reflect on how they are doing.</p></div></div><div class="col-md-6 col-lg-3"><div class="feature-card"><span class="icon-box blue"><i class="bi bi-cloud-sun"></i></span><h5>Mood tracking</h5><p>Build awareness of feelings with a quick daily mood check.</p></div></div><div class="col-md-6 col-lg-3"><div class="feature-card"><span class="icon-box mint"><i class="bi bi-lightbulb"></i></span><h5>Helpful insights</h5><p>Turn responses into clear, supportive observations over time.</p></div></div><div class="col-md-6 col-lg-3"><div class="feature-card"><span class="icon-box peach"><i class="bi bi-people"></i></span><h5>Parent guidance</h5><p>Give parents a better starting point for meaningful conversations.</p></div></div></div></div></section>
<section class="section-pad soft-section" id="how-it-works"><div class="container"><div class="row align-items-end mb-5"><div class="col-lg-7"><span class="eyebrow">A simple rhythm</span><h2>Wellbeing support, made easy.</h2></div><div class="col-lg-5"><p class="mb-0">MindCare creates a safe bridge between a child's feelings and the grown-ups who care about them.</p></div></div><div class="row g-4 steps-row"><div class="col-md-4"><div class="step-card"><span class="step-number">01</span><i class="bi bi-pencil-square"></i><h5>Complete a check-in</h5><p>Children answer gentle questions at their own pace.</p></div></div><div class="col-md-4"><div class="step-card"><span class="step-number">02</span><i class="bi bi-stars"></i><h5>See patterns emerge</h5><p>Responses are organized into clear wellbeing themes.</p></div></div><div class="col-md-4"><div class="step-card"><span class="step-number">03</span><i class="bi bi-chat-heart"></i><h5>Start a conversation</h5><p>Parents receive helpful context for the next small step.</p></div></div></div></div></section>
<section class="section-pad" id="about"><div class="container"><div class="about-panel"><div class="row align-items-center g-5"><div class="col-lg-6"><span class="eyebrow">Why MindCare?</span><h2>Because being heard can change everything.</h2><p>Growing up comes with big feelings. MindCare gives children a calm place to pause and parents a compassionate way to listen, without labels or judgment.</p><a class="text-link" asp-controller="Account" asp-action="Register">Join the MindCare community <i class="bi bi-arrow-right"></i></a></div><div class="col-lg-5 offset-lg-1"><div class="quote-card"><i class="bi bi-quote"></i><p>“A small check-in today can open the door to a much bigger conversation tomorrow.”</p><div class="quote-author"><span class="avatar">MC</span><span><strong>The MindCare team</strong><small>Here for every step</small></span></div></div></div></div></div></div></section>
<section class="cta-section"><div class="container"><div class="cta-panel"><div><span class="eyebrow">Start with one small step</span><h2>Make space for how they feel.</h2><p>Create a free family account and begin a kinder wellbeing routine.</p></div><a class="btn btn-light btn-lg" asp-controller="Account" asp-action="Register">Get started <i class="bi bi-arrow-up-right ms-2"></i></a></div></div></section>
