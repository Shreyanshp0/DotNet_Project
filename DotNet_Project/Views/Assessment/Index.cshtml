@{ ViewData["Title"] = "Wellbeing assessment"; }
@section Styles { <link rel="stylesheet" href="~/css/assessment.css" asp-append-version="true" /> }
<div class="assessment-page"><div class="container"><div class="assessment-header"><a class="back-link" asp-controller="Child" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to dashboard</a><div class="assessment-title"><span class="eyebrow">A quiet moment for you</span><h1>Wellbeing check-in</h1><p>Answer each question based on how you have felt over the past two weeks.</p></div><div class="assessment-progress"><div class="d-flex justify-content-between small fw-semibold"><span>Progress</span><span id="progressText">1 of 12</span></div><div class="progress"><div class="progress-bar" id="progressBar" style="width: 8.33%"></div></div></div></div><form id="assessmentForm" novalidate><div class="question-card" data-question="1"><span class="question-category">01 · Emotional wellbeing</span><h2>Do you feel happy most of the time?</h2><p class="question-helper">Think about your usual days, not just today.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q1" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="2"><span class="question-category">02 · Emotional wellbeing</span><h2>Do you feel able to talk about your feelings?</h2><p class="question-helper">It can be with someone you trust.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q2" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="3"><span class="question-category">03 · Academic stress</span><h2>Do you feel stressed about schoolwork?</h2><p class="question-helper">Include homework, tests, and deadlines.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q3" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="4"><span class="question-category">04 · Academic stress</span><h2>Do you feel able to focus when you study?</h2><p class="question-helper">Consider what helps or makes focusing harder.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q4" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="5"><span class="question-category">05 · Social relationships</span><h2>Do you feel comfortable talking to your friends?</h2><p class="question-helper">Think about sharing ideas or asking for help.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q5" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="6"><span class="question-category">06 · Social relationships</span><h2>Do you feel included by other children?</h2><p class="question-helper">At school, activities, or in your neighborhood.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q6" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="7"><span class="question-category">07 · Sleep and lifestyle</span><h2>Do you get enough sleep?</h2><p class="question-helper">Think about waking up feeling rested.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q7" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="8"><span class="question-category">08 · Sleep and lifestyle</span><h2>Do you make time for things you enjoy?</h2><p class="question-helper">Hobbies, play, rest, or time with family count too.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q8" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="9"><span class="question-category">09 · Self-confidence</span><h2>Do you feel confident about yourself?</h2><p class="question-helper">Remember, confidence can look different each day.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q9" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="10"><span class="question-category">10 · Self-confidence</span><h2>Do you feel proud when you learn something new?</h2><p class="question-helper">Big achievements and tiny wins both matter.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q10" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="11"><span class="question-category">11 · Emotional wellbeing</span><h2>Do you know what helps you feel calmer?</h2><p class="question-helper">This could be music, movement, talking, or quiet time.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q11" value="@answer" required><span>@answer</span></label> }</div></div><div class="question-card d-none" data-question="12"><span class="question-category">12 · Your voice</span><h2>Do you feel there is someone you can turn to when you need support?</h2><p class="question-helper">A trusted adult, friend, teacher, or family member.</p><div class="answer-grid">@foreach (var answer in new[] { "Never", "Rarely", "Sometimes", "Often", "Always" }) { <label><input type="radio" name="q12" value="@answer" required><span>@answer</span></label> }</div></div><div class="assessment-actions"><button type="button" class="btn btn-outline-secondary" id="previousButton" disabled><i class="bi bi-arrow-left me-2"></i> Previous</button><button type="button" class="btn btn-primary" id="nextButton">Next question <i class="bi bi-arrow-right ms-2"></i></button><button type="submit" class="btn btn-primary d-none" id="submitButton">Submit assessment <i class="bi bi-check2 ms-2"></i></button></div><p class="assessment-note"><i class="bi bi-shield-check"></i> Your answers are private and help create a more supportive conversation.</p></form></div></div>
@section Scripts { <script src="~/js/assessment.js" asp-append-version="true"></script> }
