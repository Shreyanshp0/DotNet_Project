@{ ViewData["Title"] = "Student space"; ViewData["PageClass"] = "dashboard-page"; }
@section Styles { <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" /> }
<div class="dashboard-wrap"><div class="container"><div class="dashboard-top"><div><span class="eyebrow">Tuesday, October 14</span><h1>Hi, Alex <span class="wave">👋</span></h1><p class="text-muted mb-0">A small check-in can make a big difference.</p></div><div class="profile-chip"><span class="avatar avatar-blue">AS</span><span class="d-none d-sm-block"><strong>Alex Smith</strong><small>Student space</small></span><i class="bi bi-chevron-down"></i></div></div><section class="daily-wellbeing"><div class="section-heading dashboard-section-heading"><div><span class="eyebrow">Tuesday, October 14</span><h2>My Daily Well-being</h2><p>Complete your daily mood and journal when it feels right. The questionnaire is separate and does not count toward your daily progress.</p></div><div class="daily-progress-badge"><strong id="dailyProgressCount">1 of 2</strong><span>daily activities</span></div></div><div class="row g-4"><div class="col-lg-4"><article class="dashboard-card daily-activity-card"><span class="activity-card-icon blue"><i class="bi bi-emoji-smile"></i></span><span class="card-kicker">Daily Mood Check-in</span><h3>How are you feeling?</h3><p class="text-muted">You have checked in <strong id="todayMoodCount">2 times</strong> today.</p><span class="activity-status status-complete"><i class="bi bi-check-circle-fill"></i> Completed today</span><a class="btn btn-primary w-100 mt-4" asp-action="MoodCheckIn">Check in again <i class="bi bi-arrow-right ms-2"></i></a></article></div><div class="col-lg-4"><article class="dashboard-card daily-activity-card"><span class="activity-card-icon lavender"><i class="bi bi-clipboard2-heart"></i></span><span class="card-kicker">Well-being Assessment</span><h3>Reflect at your pace</h3><p class="text-muted">Last completed <strong>October 07, 2026</strong>.</p><span class="activity-status status-neutral"><i class="bi bi-clock"></i> Available again</span><a class="btn btn-outline-primary w-100 mt-4" asp-controller="Assessment" asp-action="Index">Start assessment <i class="bi bi-arrow-right ms-2"></i></a></article></div><div class="col-lg-4"><article class="dashboard-card daily-activity-card"><span class="activity-card-icon mint"><i class="bi bi-journal-heart"></i></span><span class="card-kicker">My Daily Journal</span><h3>How was your day?</h3><p class="text-muted">A few words can help you notice what matters.</p><span class="activity-status status-pending"><i class="bi bi-circle"></i> Not completed today</span><a class="btn btn-outline-primary w-100 mt-4" asp-action="Journal">Open journal <i class="bi bi-arrow-right ms-2"></i></a></article></div></div></section><div class="dashboard-card buddy-dashboard-card mt-4"><div class="buddy-dashboard-icon"><i class="bi bi-stars"></i></div><div><span class="card-kicker">MindCare Buddy</span><h3>Need someone to talk to?</h3><p class="text-muted mb-3">MindCare Buddy is here to listen.</p><a class="btn btn-primary" asp-action="Buddy">Talk to Buddy <i class="bi bi-arrow-right ms-2"></i></a></div></div><div class="row g-4 mt-2"><div class="col-lg-8"><div class="dashboard-card assessment-cta"><div><span class="card-kicker">A little support</span><h3>You are building a healthy habit.</h3><p>Daily activities are for noticing how you feel, not for getting perfect answers.</p><a class="text-link" href="mailto:hello@mindcare.example">Need help or want to talk? <i class="bi bi-arrow-right"></i></a></div><div class="cta-icon"><i class="bi bi-chat-heart"></i></div></div></div><div class="col-lg-4"><div class="tip-card h-100"><i class="bi bi-lightbulb-fill"></i><div><strong>Today's little tip</strong><p class="mb-0">A few slow breaths can help your body feel calmer.</p><a class="support-link mt-2" asp-action="JournalHistory">View journal history</a></div></div></div></div></div></div>