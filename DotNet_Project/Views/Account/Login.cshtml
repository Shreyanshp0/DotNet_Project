@{ ViewData["Title"] = "Log in"; }
<div class="auth-page"><div class="container"><div class="row justify-content-center"><div class="col-lg-10"><div class="auth-shell"><div class="auth-intro"><span class="eyebrow">Welcome back</span><h1>Good to see you again.</h1><p>Pick up where you left off and make a little space for wellbeing today.</p><div class="auth-illustration"><i class="bi bi-chat-heart-fill"></i><span>Every feeling is worth listening to.</span></div></div><div class="auth-form"><h3>Log in to MindCare</h3><p class="text-muted mb-4">Use your account to continue.</p><form class="needs-validation" id="loginForm" data-account-form="login" novalidate><div class="mb-3"><label class="form-label" for="email">Email address</label><input class="form-control" type="email" id="email" name="Email" placeholder="you@example.com" required><div class="invalid-feedback">Please enter a valid email address.</div></div><div class="mb-3"><div class="d-flex justify-content-between"><label class="form-label" for="password">Password</label><a href="#" class="small text-link">Forgot password?</a></div><div class="password-wrap"><input class="form-control" type="password" id="password" name="Password" placeholder="Enter your password" required><button type="button" class="password-toggle" aria-label="Show password"><i class="bi bi-eye"></i></button></div><div class="invalid-feedback">Please enter your password.</div></div><div class="d-flex justify-content-between align-items-center mb-4"><div class="form-check"><input class="form-check-input" type="checkbox" id="remember" name="RememberMe"><label class="form-check-label" for="remember">Remember me</label></div></div><div class="role-picker mb-4"><span class="form-label d-block">I am logging in as</span><div class="row g-2"><div class="col-6"><input type="radio" class="btn-check" name="Role" id="parentRole" value="Parent" checked><label class="role-option" for="parentRole"><i class="bi bi-person-heart"></i> Parent</label></div><div class="col-6"><input type="radio" class="btn-check" name="Role" id="studentRole" value="Student"><label class="role-option" for="studentRole"><i class="bi bi-stars"></i> Student</label></div></div></div><button class="btn btn-primary w-100 btn-lg" type="submit">Log in <i class="bi bi-arrow-right ms-2"></i></button></form><p class="text-center text-muted small mt-4 mb-0">New to MindCare? <a class="text-link" asp-action="Register">Create an account</a></p></div></div></div></div></div>
</div>
