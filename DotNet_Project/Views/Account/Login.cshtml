@model DotNet_Project.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<div class="auth-page"><div class="container"><div class="row justify-content-center"><div class="col-lg-10"><div class="auth-shell">
    <div class="auth-intro"><span class="eyebrow">Welcome back</span><h1>Good to see you again.</h1><p>Pick up where you left off and make a little space for wellbeing today.</p><div class="auth-illustration"><i class="bi bi-chat-heart-fill"></i><span>Every feeling is worth listening to.</span></div></div>
    <div class="auth-form"><h3>Log in to MindCare</h3><p class="text-muted mb-4">Use your email or username.</p>
        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="UserNameOrEmail" class="form-label">Email or username</label><input asp-for="UserNameOrEmail" class="form-control" autocomplete="username"/><span asp-validation-for="UserNameOrEmail" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" class="form-control" autocomplete="current-password"/><span asp-validation-for="Password" class="text-danger"></span></div>
            <div class="form-check mb-4"><input asp-for="RememberMe" class="form-check-input"/><label asp-for="RememberMe" class="form-check-label">Remember me</label></div>
            <button class="btn btn-primary w-100 btn-lg" type="submit">Log in <i class="bi bi-arrow-right ms-2"></i></button>
        </form><p class="text-center text-muted small mt-4 mb-0">New to MindCare? <a class="text-link" asp-action="Register">Create a parent account</a></p>
    </div>
</div></div></div></div></div>
