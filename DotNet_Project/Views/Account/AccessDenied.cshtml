@{
    ViewData["Title"] = "Access denied";
}
<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="auth-shell">
                    <div class="auth-form w-100 text-center">
                        <span class="eyebrow">Access restricted</span>
                        <h1 class="mt-2">You don't have permission to view this page</h1>
                        <p class="text-muted mt-2 mb-4">If you think this is a mistake, return to your dashboard or sign in with the right account.</p>
                        <div class="d-flex justify-content-center gap-2">
                            @if (User.IsInRole("Parent"))
                            {
                                <a asp-controller="Parent" asp-action="Index" class="btn btn-primary">Go to Parent Dashboard</a>
                            }
                            else if (User.IsInRole("Child"))
                            {
                                <a asp-controller="Child" asp-action="Index" class="btn btn-primary">Go to Child Dashboard</a>
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return Home</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
