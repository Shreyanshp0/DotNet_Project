@model DotNet_Project.ViewModels.ParentRegisterViewModel
@{ ViewData["Title"] = "Create your account"; }
<div class="auth-page"><div class="container"><div class="row justify-content-center"><div class="col-lg-10"><div class="auth-shell">
    <div class="auth-intro register-intro"><span class="eyebrow">A caring start</span><h1>Let's make room for wellbeing.</h1><p>Set up your family account in a few simple steps.</p><ul class="check-list"><li><i class="bi bi-check-circle-fill"></i> Safe, private check-ins</li><li><i class="bi bi-check-circle-fill"></i> Insights made for families</li><li><i class="bi bi-check-circle-fill"></i> No labels, no judgment</li></ul></div>
    <div class="auth-form"><h3>Create your parent account</h3><p class="text-muted mb-4">Start your MindCare journey today.</p>
        <form asp-action="Register" method="post" class="needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control" autocomplete="name"/><span asp-validation-for="FullName" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Email" class="form-label">Email address</label><input asp-for="Email" class="form-control" autocomplete="email"/><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="row g-3"><div class="col-md-6"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div></div>
            <button class="btn btn-primary w-100 btn-lg mt-4" type="submit">Create account <i class="bi bi-arrow-right ms-2"></i></button>
        </form><p class="text-center text-muted small mt-4 mb-0">Already have an account? <a class="text-link" asp-action="Login">Log in</a></p>
    </div>
</div></div></div></div></div>
