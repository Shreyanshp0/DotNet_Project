@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isChild = User.IsInRole("Child");
    var isParent = User.IsInRole("Parent");
    var isBuddyPage = string.Equals(controller, "Child", StringComparison.OrdinalIgnoreCase) &&
                      string.Equals(action, "Buddy", StringComparison.OrdinalIgnoreCase);
    var isAccountPage = string.Equals(controller, "Account", StringComparison.OrdinalIgnoreCase);
}
@if (isAuthenticated && !isBuddyPage && !isAccountPage && (isChild || isParent))
{
    <button type="button"
            class="floating-buddy-trigger"
            id="floatingBuddyTrigger"
            aria-label="Open MindCare Buddy"
            aria-expanded="false"
            title="MindCare Buddy">
        <i class="bi bi-stars"></i>
    </button>

    <div class="floating-buddy-panel d-none" id="floatingBuddyPanel" role="dialog" aria-label="MindCare Buddy">
        <div class="floating-buddy-header">
            <div class="floating-buddy-title">
                <span class="floating-buddy-icon"><i class="bi bi-stars"></i></span>
                <div>
                    <strong class="d-block lh-sm" style="font-size:.92rem;">MindCare Buddy</strong>
                    <small class="text-muted" style="font-size:.72rem;">@(isChild ? "Friendly listening space" : "Parent guide")</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-1">
                @if (isChild)
                {
                    <a asp-controller="Child" asp-action="Buddy" class="btn btn-ghost btn-sm px-2 py-1" title="Open full Buddy page">
                        <i class="bi bi-arrows-angle-expand"></i>
                    </a>
                }
                <button type="button" class="btn btn-ghost btn-sm px-2 py-1" id="floatingBuddyClose" aria-label="Close MindCare Buddy">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        @if (isChild)
        {
            <div class="floating-buddy-messages" id="floatingBuddyMessages" aria-live="polite">
                <div class="floating-msg floating-msg-bot">Hi! I’m MindCare Buddy. How are you feeling right now?</div>
            </div>
            <div class="px-3 pb-1 small text-muted d-none" id="floatingBuddyTyping">Buddy is thinking...</div>
            <form class="floating-buddy-composer" id="floatingBuddyForm" data-endpoint="/Chat/SendMessage">
                <label class="visually-hidden" for="floatingBuddyInput">Message MindCare Buddy</label>
                <textarea id="floatingBuddyInput" rows="1" maxlength="500" placeholder="Type a message..." autocomplete="off"></textarea>
                <button class="floating-buddy-send" type="submit" aria-label="Send message"><i class="bi bi-send-fill"></i></button>
            </form>
        }
        else if (isParent)
        {
            <div class="p-3">
                <p class="small text-muted mb-3">
                    MindCare Buddy is a dedicated listening space for children. As a parent, you can review your children's Buddy conversations from your dashboard.
                </p>
                <a asp-controller="Parent" asp-action="ChatHistory" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-chat-dots me-1"></i> View Buddy Conversations
                </a>
            </div>
        }
    </div>
}
