@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isChild = User.IsInRole("Child");
    var isParent = User.IsInRole("Parent");

    var isHome = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase) &&
                 string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isChildDashboard = string.Equals(currentController, "Child", StringComparison.OrdinalIgnoreCase) ||
                           string.Equals(currentController, "Assessment", StringComparison.OrdinalIgnoreCase);
    var isParentChatHistory = string.Equals(currentController, "Parent", StringComparison.OrdinalIgnoreCase) &&
                              string.Equals(currentAction, "ChatHistory", StringComparison.OrdinalIgnoreCase);
    var isParentHistory = string.Equals(currentController, "Parent", StringComparison.OrdinalIgnoreCase) &&
                          (string.Equals(currentAction, "History", StringComparison.OrdinalIgnoreCase) ||
                           string.Equals(currentAction, "QuestionnaireDetails", StringComparison.OrdinalIgnoreCase));
    var isParentDashboard = string.Equals(currentController, "Parent", StringComparison.OrdinalIgnoreCase) &&
                            !isParentChatHistory && !isParentHistory;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MindCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["PageClass"]">
    @Html.AntiForgeryToken()
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index" aria-label="MindCare home">
                    <span class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></span>
                    <span>mind<span>care</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav mx-auto gap-lg-2">
                        <li class="nav-item"><a class="nav-link @(isHome ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#about">About</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#features">Features</a></li>
                        @if (isChild)
                        {
                            <li class="nav-item"><a class="nav-link @(isChildDashboard ? "active" : "")" asp-controller="Child" asp-action="Index">Child Dashboard</a></li>
                        }
                        @if (isParent)
                        {
                            <li class="nav-item"><a class="nav-link @(isParentDashboard ? "active" : "")" asp-controller="Parent" asp-action="Index">Parent Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @(isParentChatHistory ? "active" : "")" asp-controller="Parent" asp-action="ChatHistory">Buddy Conversations</a></li>
                            <li class="nav-item"><a class="nav-link @(isParentHistory ? "active" : "")" asp-controller="Parent" asp-action="History">Assessment History</a></li>
                        }
                    </ul>
                    @if (!isAuthenticated)
                    {
                        <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0 nav-actions nav-actions-guest">
                            <a class="btn btn-ghost btn-sm nav-login" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Get started <i class="bi bi-arrow-up-right ms-1"></i></a>
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3 mt-lg-0 d-flex align-items-center">
                            @Html.AntiForgeryToken()
                            <button class="nav-logout-btn" type="submit">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Log out</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>

    <partial name="_FloatingBuddy" />

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <a class="brand-mark text-white" asp-controller="Home" asp-action="Index"><span class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></span><span>mind<span>care</span></span></a>
                    <p class="footer-copy mt-3">A kinder way to understand how children are feeling, one conversation at a time.</p>
                </div>
                <div class="col-6 col-lg-2"><h6>Explore</h6><a href="/#about">About us</a><a href="/#features">Features</a><a href="/#how-it-works">How it works</a></div>
                <div class="col-6 col-lg-2">
                    <h6>For families</h6>
                    @if (!isAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Login">Log in</a>
                        <a asp-controller="Account" asp-action="Register">Create account</a>
                    }
                    else if (isChild)
                    {
                        <a asp-controller="Child" asp-action="Index">Child dashboard</a>
                        <a asp-controller="Child" asp-action="Buddy">MindCare Buddy</a>
                    }
                    else if (isParent)
                    {
                        <a asp-controller="Parent" asp-action="Index">Parent dashboard</a>
                        <a asp-controller="Parent" asp-action="History">Reports</a>
                    }
                </div>
                <div class="col-lg-3"><h6>Need support?</h6><a href="mailto:hello@mindcare.example">hello@mindcare.example</a><p class="small mt-3 mb-0">Always reach out to a qualified professional if you have concerns about a child's wellbeing.</p></div>
            </div>
            <div class="footer-bottom mt-5"><span>&copy; 2026 MindCare. Made with care.</span><a asp-controller="Home" asp-action="Privacy">Privacy &amp; safety</a></div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/floating-buddy.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
