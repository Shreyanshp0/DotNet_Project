<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MindCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand brand-mark" asp-controller="Home" asp-action="Index" aria-label="MindCare home">
                    <span class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></span>
                    <span>mind<span>care</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav mx-auto gap-lg-2">
                        <li class="nav-item"><a class="nav-link" href="/#top">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#about">About</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#features">Features</a></li>
                        @if (User.IsInRole("Child")) { <li class="nav-item"><a class="nav-link" asp-controller="Child" asp-action="Index">Child dashboard</a></li> }
                        @if (User.IsInRole("Parent")) { <li class="nav-item"><a class="nav-link" asp-controller="Parent" asp-action="Index">Parent dashboard</a></li><li class="nav-item"><a class="nav-link" asp-controller="Parent" asp-action="History">Assessment history</a></li> }
                    </ul>
                    @if (!(User.Identity?.IsAuthenticated ?? false)) { <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0 nav-actions nav-actions-guest">
                        <a class="btn btn-link nav-login" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Get started <i class="bi bi-arrow-up-right ms-1"></i></a>
                    </div> } else { <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3 mt-lg-0"><button class="btn btn-link nav-login" type="submit">Log out</button></form> }
                </div>
            </div>
        </nav>
    </header>
    <main role="main">
            @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <a class="brand-mark text-white" asp-controller="Home" asp-action="Index"><span class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></span><span>mind<span>care</span></span></a>
                    <p class="footer-copy mt-3">A kinder way to understand how children are feeling, one conversation at a time.</p>
                </div>
                <div class="col-6 col-lg-2"><h6>Explore</h6><a href="/#about">About us</a><a href="/#features">Features</a><a href="/#how-it-works">How it works</a></div>
                <div class="col-6 col-lg-2"><h6>For families</h6><a asp-controller="Account" asp-action="Login">Log in</a><a asp-controller="Account" asp-action="Register">Create account</a><a asp-controller="Parent" asp-action="History">Reports</a></div>
                <div class="col-lg-3"><h6>Need support?</h6><a href="mailto:hello@mindcare.example">hello@mindcare.example</a><p class="small mt-3 mb-0">Always reach out to a qualified professional if you have concerns about a child's wellbeing.</p></div>
            </div>
            <div class="footer-bottom mt-5"><span>&copy; 2026 MindCare. Made with care.</span><a asp-controller="Home" asp-action="Privacy">Privacy &amp; safety</a></div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
