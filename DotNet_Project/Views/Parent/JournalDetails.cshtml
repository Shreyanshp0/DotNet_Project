@model DotNet_Project.Models.JournalEntry
@{
    ViewData["Title"] = "Journal details";
    var activeChild = ViewBag.ActiveChild as DotNet_Project.Models.ChildProfile;
    var childName = activeChild?.ChildName ?? "Alex";
}
@section Styles {
    <link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" />
}
<div class="activity-page parent-activity-page">
    <div class="container activity-container">
        <a class="back-link" asp-action="DailyActivity" asp-route-childId="@(activeChild?.Id)"><i class="bi bi-arrow-left"></i> Back to daily activity</a>
        <div class="activity-heading">
            <span class="eyebrow">Shared reflections</span>
            <h1>@childName's journal entry</h1>
            <p>These are the entries @childName has chosen to submit. Please read them with care and respect.</p>
        </div>
        <div class="privacy-notice">
            <i class="bi bi-eye"></i>
            <p class="mb-0">Only submitted entries are visible to you. Blank answers and “Prefer not to answer” choices are respected.</p>
        </div>
        <div class="journal-history-list">
            @if (Model != null)
            {
                <article class="journal-entry">
                    <div class="entry-heading">
                        <div>
                            <span class="card-kicker">@Model.EntryDate.ToString("MMMM dd, yyyy") · @Model.CreatedAt.ToLocalTime().ToString("h:mm tt")</span>
                            <h3>Daily reflection</h3>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Emotion))
                        {
                            <span class="entry-emotion">@Model.Emotion</span>
                        }
                    </div>
                    <p><strong>Best part:</strong> @Model.BestPart</p>
                    <p><strong>Was anything difficult?</strong> @Model.DifficultPart</p>
                    <p><strong>How would you describe your day?</strong> @Model.DayDescription</p>
                    <p><strong>Anything they would like help with?</strong> @(string.IsNullOrEmpty(Model.HelpRequired) ? "Not shared." : Model.HelpRequired)</p>
                </article>
            }
            else
            {
                <article class="journal-entry">
                    <p class="text-muted mb-0">No journal entry found for @childName.</p>
                </article>
            }
        </div>
    </div>
</div>
