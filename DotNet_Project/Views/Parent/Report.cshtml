@model DotNet_Project.DTOs.AIReportResponse
@{
    ViewData["Title"] = "Wellbeing report";
    ViewData["PageClass"] = "report-page";
    var childName = Model?.ChildName ?? "Alex Smith";
    var childAge = Model?.ChildAge ?? 12;
    var grade = Model?.GradeOrAgeGroup ?? "Grade 7";
    var assessmentDate = Model?.AssessmentDate ?? DateTime.UtcNow.ToString("yyyy-MM-dd");
    var assessmentId = Model?.AssessmentId ?? 1042;
    var pattern = Model?.OverallPattern ?? "Positive";
    var summary = Model?.Summary ?? "Alex's responses suggest a generally positive sense of self and strong social connections.";
    var emotionalScore = Model?.CategoryScores?.EmotionalWellbeing ?? 82;
    var academicScore = Model?.CategoryScores?.AcademicStress ?? 58;
    var socialScore = Model?.CategoryScores?.SocialRelationships ?? 78;
    var lifestyleScore = Model?.CategoryScores?.SleepAndLifestyle ?? 70;
    var strengths = Model?.Strengths?.Split('\n', StringSplitOptions.RemoveEmptyEntries) ?? ["Comfortable building friendships", "Can recognize calming strategies", "Enjoys positive daily moments"];
    var concerns = Model?.AreasOfConcern?.Split('\n', StringSplitOptions.RemoveEmptyEntries) ?? ["Talk about schoolwork pressure", "Protect a consistent sleep routine"];
    var suggestions = Model?.Suggestions?.Split('\n', StringSplitOptions.RemoveEmptyEntries) ?? ["Ask open questions", "Make space for breaks", "Celebrate effort"];
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}
<div class="report-wrap">
    <div class="container">
        <div class="report-toolbar">
            <a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Parent dashboard</a>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-download me-2"></i> Save report</button>
        </div>
        <div class="report-hero">
            <div>
                <span class="eyebrow">MindCare wellbeing report</span>
                <h1>@childName's wellbeing snapshot</h1>
                <p class="mb-0">A thoughtful summary of responses from the @assessmentDate check-in.</p>
            </div>
            <div class="report-status"><i class="bi bi-stars"></i> AI-generated · Not professionally reviewed</div>
        </div>
        <div class="report-meta-grid">
            <div><span>Child</span><strong>@childName</strong><small>Age @childAge · @grade</small></div>
            <div><span>Assessment date</span><strong>@assessmentDate</strong><small>Completed</small></div>
            <div><span>Assessment ID</span><strong>MC-@assessmentId</strong><small>10 questions answered</small></div>
        </div>
        <div class="report-section">
            <div class="section-title">
                <span class="section-icon blue"><i class="bi bi-heart-pulse"></i></span>
                <div>
                    <span class="card-kicker">01 · Overall summary</span>
                    <h2>A thoughtful reflection of recent check-ins</h2>
                </div>
            </div>
            <div class="summary-highlight">
                <div class="overall-score qualitative-summary">
                    <strong>@pattern</strong><span>response<br>pattern</span>
                </div>
                <div>
                    <p class="mb-0">@summary</p>
                </div>
            </div>
        </div>
        <div class="row g-4 report-section">
            <div class="col-lg-6">
                <div class="report-observation">
                    <span class="section-icon lavender"><i class="bi bi-emoji-smile"></i></span>
                    <span class="card-kicker">02 · Emotional wellbeing</span>
                    <h3>Finding their balance</h3>
                    <p>Awareness of feelings and ability to find calm during everyday routines.</p>
                    <div class="report-meter">
                        <div class="d-flex justify-content-between">
                            <span>Wellbeing score</span>
                            <strong>@emotionalScore%</strong>
                        </div>
                        <div class="qualitative-bar">
                            <span class="qualitative-fill bg-lavender" style="width:@emotionalScore%"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="report-observation">
                    <span class="section-icon peach"><i class="bi bi-book"></i></span>
                    <span class="card-kicker">03 · Academic stress & focus</span>
                    <h3>Making schoolwork feel manageable</h3>
                    <p>Ability to manage school pressures, focus on studies, and balance learning.</p>
                    <div class="report-meter">
                        <div class="d-flex justify-content-between">
                            <span>Coping score</span>
                            <strong>@academicScore%</strong>
                        </div>
                        <div class="qualitative-bar">
                            <span class="qualitative-fill bg-peach" style="width:@academicScore%"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="report-observation">
                    <span class="section-icon mint"><i class="bi bi-people"></i></span>
                    <span class="card-kicker">04 · Social relationships</span>
                    <h3>Connected and supported</h3>
                    <p>Comfort communicating with friends and feeling included by peers.</p>
                    <div class="report-meter">
                        <div class="d-flex justify-content-between">
                            <span>Connection score</span>
                            <strong>@socialScore%</strong>
                        </div>
                        <div class="qualitative-bar">
                            <span class="qualitative-fill bg-mint" style="width:@socialScore%"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="report-observation">
                    <span class="section-icon blue"><i class="bi bi-moon-stars"></i></span>
                    <span class="card-kicker">05 · Sleep and lifestyle</span>
                    <h3>Protecting time to recharge</h3>
                    <p>Restful sleep routines and healthy balance between work and hobbies.</p>
                    <div class="report-meter">
                        <div class="d-flex justify-content-between">
                            <span>Lifestyle score</span>
                            <strong>@lifestyleScore%</strong>
                        </div>
                        <div class="qualitative-bar">
                            <span class="qualitative-fill bg-blue" style="width:@lifestyleScore%"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row g-4 report-section">
            <div class="col-lg-6">
                <div class="strengths-panel">
                    <span class="card-kicker">06 · Strengths to celebrate</span>
                    <h2>What is going well</h2>
                    <ul class="report-list">
                        @foreach (var s in strengths)
                        {
                            <li><i class="bi bi-check-circle-fill"></i> @s</li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="attention-panel">
                    <span class="card-kicker">07 · Gentle areas of attention</span>
                    <h2>Where support may help</h2>
                    <ul class="report-list">
                        @foreach (var c in concerns)
                        {
                            <li><i class="bi bi-arrow-right-circle-fill"></i> @c</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="suggestions-panel report-section">
            <div class="section-title">
                <span class="section-icon mint"><i class="bi bi-lightbulb"></i></span>
                <div>
                    <span class="card-kicker">08 · Suggestions for parents</span>
                    <h2>Small ways to offer support</h2>
                </div>
            </div>
            <div class="row g-3">
                @foreach (var tip in suggestions)
                {
                    <div class="col-md-4">
                        <div class="suggestion">
                            <p class="mb-0">@tip</p>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="disclaimer">
            <i class="bi bi-info-circle"></i>
            <p class="mb-0"><strong>How to read this report:</strong> The category bars illustrate response patterns for discussion only; they are not clinical scores. This AI-generated report has not been professionally reviewed. It provides informational insights based on questionnaire responses and is not a medical diagnosis or a substitute for professional assessment.</p>
        </div>
    </div>
</div>
