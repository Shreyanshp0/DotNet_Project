@using DotNet_Project.Models
@{
    ViewData["Title"] = "Parent dashboard";
    ViewData["PageClass"] = "dashboard-page";
    var children = ViewBag.Children as List<ChildProfile> ?? new();
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}
<div class="dashboard-wrap">
    <div class="container">
        <div class="dashboard-top">
            <div>
                <span class="eyebrow">Parent space</span>
                <h1>My Children</h1>
                <p class="text-muted mb-0">Manage child accounts and wellbeing insights linked to your family.</p>
            </div>
            <a asp-action="AddChild" class="btn btn-primary">Add Child <i class="bi bi-plus-lg ms-2"></i></a>
        </div>
        @if (children.Count == 0)
        {
            <div class="dashboard-card">
                <h2>Welcome to MindCare</h2>
                <p class="text-muted">Create a linked child account to get started.</p>
                <a asp-action="AddChild" class="btn btn-primary">Add Child</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var child in children)
                {
                    var mustChange = child.ChildUser?.MustChangePassword ?? false;
                    <div class="col-lg-6">
                        <div class="dashboard-card child-card h-100 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <span class="card-kicker">Your child</span>
                                    <h3 class="mb-1">@child.ChildName</h3>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    @if (mustChange)
                                    {
                                        <span class="status-pill" style="background:#fff7e6; color:#9a6700;">Pending Password Change</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-good"><i class="bi bi-circle-fill"></i> Active</span>
                                    }
                                    <div class="dropdown">
                                        <button class="btn btn-ghost btn-sm px-2 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account actions for @child.ChildName">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                            <li><h6 class="dropdown-header">Account management</h6></li>
                                            <li><a class="dropdown-item" asp-action="ChildDetails" asp-route-id="@child.Id"><i class="bi bi-person-badge me-2"></i>View profile</a></li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <form asp-action="ResetChildPassword" asp-route-id="@child.Id" method="post" onsubmit="return confirm('Generate a new temporary password for @child.ChildName?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-key me-2"></i>Reset password</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-2 mb-3">
                                <p class="text-muted small mb-1">Child ID: <span class="font-monospace fw-semibold text-dark">@(child.ChildUser?.UserName ?? "—")</span></p>
                                <p class="text-muted small mb-1">Date of birth: @child.DateOfBirth.ToString("dd MMM yyyy")</p>
                                @if (!string.IsNullOrEmpty(child.GradeOrAgeGroup))
                                {
                                    <p class="text-muted small mb-1">Group: @child.GradeOrAgeGroup</p>
                                }
                                <p class="text-muted small mb-0">Created @child.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</p>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-auto pt-3 border-top">
                                <a asp-action="DailyActivity" asp-route-childId="@child.Id" class="btn btn-primary btn-sm">Daily Activity <i class="bi bi-activity ms-1"></i></a>
                                <a asp-action="ChildDetails" asp-route-id="@child.Id" class="btn btn-outline-secondary btn-sm">View Details</a>
                                <a asp-action="ChatHistory" asp-route-childId="@child.Id" class="btn btn-outline-secondary btn-sm">Buddy Conversations</a>
                                <a asp-action="History" asp-route-childId="@child.Id" class="btn btn-outline-secondary btn-sm">History</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
