@using DotNet_Project.Models
@{ ViewData["Title"] = "Parent dashboard"; ViewData["PageClass"] = "dashboard-page"; var children = ViewBag.Children as List<ChildProfile> ?? new(); }
@section Styles { <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" /> }
<div class="dashboard-wrap"><div class="container">
    <div class="dashboard-top"><div><span class="eyebrow">Parent space</span><h1>Your family dashboard</h1><p class="text-muted mb-0">View the child accounts linked to your family.</p></div><a asp-action="AddChild" class="btn btn-primary">Add child account <i class="bi bi-plus-lg ms-2"></i></a></div>
    @if (children.Count == 0) { <div class="dashboard-card"><h2>Welcome to MindCare</h2><p class="text-muted">Create a linked child account to get started.</p><a asp-action="AddChild" class="btn btn-primary">Create child account</a></div> }
    else { <div class="row g-4">@foreach (var child in children) { <div class="col-lg-6"><div class="dashboard-card child-card"><span class="card-kicker">Your child</span><h3>@child.ChildName</h3><p class="text-muted">Date of birth: @child.DateOfBirth.ToString("dd MMM yyyy")</p><p class="text-muted">Created @child.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</p></div></div> }</div> }
</div></div>
