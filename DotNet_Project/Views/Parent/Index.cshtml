@using DotNet_Project.Models
@{
    ViewData["Title"] = "Parent dashboard";
    ViewData["PageClass"] = "dashboard-page";
    var children = ViewBag.Children as List<ChildProfile> ?? new();
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}
<div class="dashboard-wrap">
    <div class="container">
        <div class="dashboard-top">
            <div>
                <span class="eyebrow">Parent space</span>
                <h1>My Children</h1>
                <p class="text-muted mb-0">Manage child accounts linked to your family.</p>
            </div>
            <a asp-action="AddChild" class="btn btn-primary">Add Child <i class="bi bi-plus-lg ms-2"></i></a>
        </div>
        @if (children.Count == 0)
        {
            <div class="dashboard-card">
                <h2>Welcome to MindCare</h2>
                <p class="text-muted">Create a linked child account to get started.</p>
                <a asp-action="AddChild" class="btn btn-primary">Add Child</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var child in children)
                {
                    var mustChange = child.ChildUser?.MustChangePassword ?? false;
                    <div class="col-lg-6">
                        <div class="dashboard-card child-card">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="card-kicker">Your child</span>
                                    <h3 class="mb-1">@child.ChildName</h3>
                                </div>
                                @if (mustChange)
                                {
                                    <span class="badge bg-warning text-dark">Pending Password Change</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </div>
                            <p class="text-muted mb-1">Child ID: <span class="font-monospace fw-semibold">@(child.ChildUser?.UserName ?? "—")</span></p>
                            <p class="text-muted mb-1">Date of birth: @child.DateOfBirth.ToString("dd MMM yyyy")</p>
                            @if (!string.IsNullOrEmpty(child.GradeOrAgeGroup))
                            {
                                <p class="text-muted mb-1">Group: @child.GradeOrAgeGroup</p>
                            }
                            <p class="text-muted">Created @child.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</p>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <a asp-action="ChildDetails" asp-route-id="@child.Id" class="btn btn-outline-dark btn-sm">View Details</a>
                                <form asp-action="ResetChildPassword" asp-route-id="@child.Id" method="post" class="d-inline" onsubmit="return confirm('Generate a new temporary password for @child.ChildName?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-warning btn-sm">Reset Password</button>
                                </form>
                                <a asp-action="DailyActivity" asp-route-childId="@child.Id" class="btn btn-primary btn-sm">Daily Activity <i class="bi bi-activity ms-1"></i></a>
                                <a asp-action="ChatHistory" asp-route-childId="@child.Id" class="btn btn-outline-info btn-sm">Buddy Chat <i class="bi bi-chat-dots ms-1"></i></a>
                                <a asp-action="History" asp-route-childId="@child.Id" class="btn btn-outline-primary btn-sm">History</a>
                                <a asp-action="Report" class="btn btn-outline-secondary btn-sm">Latest AI Report</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
