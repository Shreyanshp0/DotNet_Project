@{ ViewData["Title"] = "Child's daily activity"; }
@section Styles { <link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" /> }
<div class="activity-page parent-activity-page"><div class="container"><div class="activity-toolbar"><a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Parent dashboard</a><a class="btn btn-outline-secondary btn-sm" asp-action="Report" asp-route-id="1042">View AI report</a></div><div class="activity-heading"><span class="eyebrow">Child's Daily Activity</span><h1>Alex's activity timeline</h1><p>Select a date to review mood entries, questionnaire responses, and journal reflections.</p></div><div class="date-selector"><button class="date-choice" data-date="2026-10-14"><strong>Today</strong><small>Oct 14</small></button><button class="date-choice active" data-date="2026-10-13"><strong>Yesterday</strong><small>Oct 13</small></button><button class="date-choice" data-date="2026-10-07"><strong>Oct 07</strong><small>Assessment</small></button></div><div class="activity-date-label" id="activityDateLabel">Activity for October 13, 2026</div><div class="row g-4"><div class="col-lg-7"><section class="activity-card"><div class="d-flex justify-content-between align-items-center mb-3"><div><span class="card-kicker">Mood history</span><h3>Check-ins</h3></div><span class="activity-count">2 entries</span></div><div class="entry-list" id="parentMoodEntries"><div class="entry-row"><span class="entry-emoji">😄</span><div><strong>Great</strong><small>Had fun at art club</small></div><time>8:25 AM</time></div><div class="entry-row"><span class="entry-emoji">🙂</span><div><strong>Good</strong><small>No explanation shared</small></div><time>4:40 PM</time></div></div></section><section class="activity-card mt-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><span class="card-kicker">Questionnaire responses</span><h3>Wellbeing assessment</h3></div><span class="activity-status status-complete">Submitted Oct 07</span></div><p class="text-muted small">The latest 10-question assessment is available to review.</p><a class="btn btn-outline-primary" asp-action="QuestionnaireDetails">View all responses <i class="bi bi-arrow-right ms-2"></i></a></section></div><div class="col-lg-5"><section class="activity-card journal-preview"><span class="card-kicker">Journal history</span><h3>Alex's reflection</h3><span class="entry-emotion">🌿 Calm</span><p class="journal-quote" id="parentJournalQuote">“Finished my art project and had lunch with my friends.”</p><p class="small text-muted" id="parentJournalDate">Submitted October 13 at 7:48 PM</p><a class="text-link" asp-action="JournalDetails">View journal entries <i class="bi bi-arrow-right"></i></a></section><section class="empty-state-card mt-4"><i class="bi bi-shield-check"></i><p><strong>Respecting Alex's privacy</strong><br>Only entries Alex chooses to submit are shown here.</p></section></div></div></div></div>
@section Scripts { <script src="~/js/activities.js" asp-append-version="true"></script> }