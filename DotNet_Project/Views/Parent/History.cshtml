@using DotNet_Project.Models
@{
    ViewData["Title"] = "Assessment history";
    ViewData["PageClass"] = "dashboard-page";
    var activeChild = ViewBag.ActiveChild as ChildProfile;
    var children = ViewBag.Children as List<ChildProfile> ?? new();
    var childName = activeChild?.ChildName ?? "Alex Smith";
    var childId = activeChild?.Id ?? 0;
    var assessments = ViewBag.Assessments as List<Assessment> ?? new();
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}
<div class="dashboard-wrap">
    <div class="container">
        <div class="dashboard-top">
            <div>
                <a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Parent dashboard</a>
                <h1 class="mt-3">Assessment history</h1>
                <p class="text-muted mb-0">Review @childName's previous wellbeing check-ins.</p>
            </div>
        </div>

        @if (children.Count > 1)
        {
            <div class="mb-3 d-flex gap-2 align-items-center">
                <span class="small text-muted">Select child:</span>
                @foreach (var c in children)
                {
                    <a asp-action="History" asp-route-childId="@c.Id" class="btn btn-sm @(c.Id == childId ? "btn-primary" : "btn-outline-secondary")">@c.ChildName</a>
                }
            </div>
        }

        <div class="dashboard-card history-card">
            <div class="history-header">
                <div>
                    <span class="card-kicker">@childName · @assessments.Count @(assessments.Count == 1 ? "record" : "records")</span>
                    <h3>All assessments</h3>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Assessment ID</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (assessments.Count > 0)
                        {
                            @foreach (var item in assessments)
                            {
                                <tr>
                                    <td><strong>MC-@item.Id</strong></td>
                                    <td>@item.AssessmentDate.ToString("MMMM dd, yyyy")</td>
                                    <td><span class="status-pill status-complete">Report ready</span></td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Report" asp-route-id="@item.Id" asp-route-childId="@childId">View report</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    No assessments submitted yet for @childName.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
