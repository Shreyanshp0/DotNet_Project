@model DotNet_Project.DTOs.AssessmentAnswersResponse
@{
    ViewData["Title"] = "Questionnaire responses";
    var activeChild = ViewBag.ActiveChild as DotNet_Project.Models.ChildProfile;
    var childName = Model?.ChildName ?? activeChild?.ChildName ?? "Child";
    var assessmentDate = Model?.AssessmentDate ?? "";
    var assessmentId = Model?.AssessmentId ?? 0;
    var answers = Model?.Answers;
}
@section Styles {
    <link rel="stylesheet" href="~/css/activities.css" asp-append-version="true" />
}
<div class="activity-page parent-activity-page">
    <div class="container activity-container">
        <a class="back-link" asp-action="DailyActivity" asp-route-childId="@(activeChild?.Id)"><i class="bi bi-arrow-left"></i> Back to daily activity</a>
        @if (Model is null || answers is null || answers.Count == 0)
        {
            <div class="activity-heading">
                <span class="eyebrow">Questionnaire responses</span>
                <h1>@childName's questionnaire responses</h1>
                <p class="text-muted">No assessment submitted yet for @childName.</p>
            </div>
        }
        else
        {
            <div class="activity-heading">
                <span class="eyebrow">Submitted @assessmentDate</span>
                <h1>@childName's questionnaire responses</h1>
                <p>These are the answers recorded for assessment MC-@assessmentId. They are shown for conversation and context only.</p>
            </div>
            <div class="response-list">
                @foreach (var response in answers)
                {
                    <article class="response-item">
                        <span class="question-category">@(response.Category ?? "Wellbeing")</span>
                        <h3>@response.QuestionText</h3>
                        <span class="answer-badge">@response.Answer</span>
                    </article>
                }
            </div>
        }
        <div class="disclaimer mt-4">
            <i class="bi bi-info-circle"></i>
            <p class="mb-0">These responses are not a diagnosis and should be discussed with care. Contact a qualified professional if you have concerns.</p>
        </div>
    </div>
</div>
