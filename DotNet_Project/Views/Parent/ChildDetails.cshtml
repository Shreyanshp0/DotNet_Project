@model DotNet_Project.Models.ChildProfile
@{
    ViewData["Title"] = $"{Model.ChildName} - Details";
    ViewData["PageClass"] = "dashboard-page";
    var mustChange = Model.ChildUser?.MustChangePassword ?? false;
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}
<div class="dashboard-wrap">
    <div class="container">
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Back to My Children</a>
        <div class="dashboard-top mt-3">
            <div>
                <span class="eyebrow">Child profile</span>
                <h1>@Model.ChildName</h1>
                <p class="text-muted mb-0">Linked child account details and wellbeing overview.</p>
            </div>
            <a asp-action="DailyActivity" asp-route-childId="@Model.Id" class="btn btn-primary">Daily Activity <i class="bi bi-activity ms-1"></i></a>
        </div>

        @if (TempData["ErrorMessage"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }

        <div class="dashboard-card">
            <span class="card-kicker">Profile details</span>
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <div class="small text-muted">Child ID / Username</div>
                    <div class="fw-semibold font-monospace">@(Model.ChildUser?.UserName ?? "—")</div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted">Account Status</div>
                    <div class="mt-1">
                        @if (mustChange)
                        {
                            <span class="status-pill" style="background:#fff7e6; color:#9a6700;">Pending Password Change</span>
                        }
                        else
                        {
                            <span class="status-pill status-good"><i class="bi bi-circle-fill"></i> Active</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted">Date of Birth</div>
                    <div class="fw-semibold">@Model.DateOfBirth.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted">Account Created</div>
                    <div class="fw-semibold">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Gender))
                {
                    <div class="col-md-6">
                        <div class="small text-muted">Gender</div>
                        <div class="fw-semibold">@Model.Gender</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.GradeOrAgeGroup))
                {
                    <div class="col-md-6">
                        <div class="small text-muted">Grade / Age Group</div>
                        <div class="fw-semibold">@Model.GradeOrAgeGroup</div>
                    </div>
                }
            </div>

            <hr class="my-4" />
            <span class="card-kicker">Wellbeing &amp; activity</span>
            <div class="d-flex flex-wrap gap-2 mt-2">
                <a asp-action="DailyActivity" asp-route-childId="@Model.Id" class="btn btn-primary btn-sm">Daily Activity <i class="bi bi-activity ms-1"></i></a>
                <a asp-action="ChatHistory" asp-route-childId="@Model.Id" class="btn btn-outline-secondary btn-sm">Buddy Conversations</a>
                <a asp-action="History" asp-route-childId="@Model.Id" class="btn btn-outline-secondary btn-sm">Assessment History</a>
                <a asp-action="Report" class="btn btn-outline-secondary btn-sm">Latest AI Report</a>
            </div>
        </div>

        <div class="dashboard-card mt-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <span class="card-kicker">Account management</span>
                    <h3 class="mb-1">Reset child password</h3>
                    <p class="text-muted small mb-0">Generate a new temporary password if your child forgot theirs. They will be prompted to set a new password on next login.</p>
                </div>
                <form asp-action="ResetChildPassword" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Generate a new temporary password for @Model.ChildName? Their current password will stop working immediately.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-destructive btn-sm">
                        <i class="bi bi-key me-1"></i> Reset password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
