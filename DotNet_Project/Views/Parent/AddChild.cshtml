@model DotNet_Project.ViewModels.ChildCreateViewModel
@{ ViewData["Title"] = "Add a child"; }
<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="auth-shell">
                    <div class="auth-form w-100">
                        <a asp-action="Index" class="back-link">← Parent dashboard</a>
                        <h1 class="mt-3">Create a child account</h1>
                        <p class="text-muted">Your child account will be linked automatically to your parent account. Leave Child ID and password blank to auto-generate secure credentials.</p>
                        <form asp-action="AddChild" method="post" id="addChildForm">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <div class="mb-3">
                                <label asp-for="ChildName" class="form-label"></label>
                                <input asp-for="ChildName" class="form-control" />
                                <span asp-validation-for="ChildName" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="DateOfBirth" class="form-label"></label>
                                <input asp-for="DateOfBirth" type="date" class="form-control" />
                                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="UserName" class="form-label"></label>
                                    <input asp-for="UserName" class="form-control" placeholder="Auto-generated (e.g. MC-2026-12345)" autocomplete="off" />
                                    <span asp-validation-for="UserName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" class="form-control" placeholder="Optional" autocomplete="off" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label"></label>
                                    <input asp-for="Password" class="form-control" placeholder="Leave blank to auto-generate" autocomplete="new-password" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword" class="form-label"></label>
                                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm if password entered" autocomplete="new-password" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <label asp-for="Gender" class="form-label"></label>
                                    <input asp-for="Gender" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="GradeOrAgeGroup" class="form-label"></label>
                                    <input asp-for="GradeOrAgeGroup" class="form-control" />
                                </div>
                            </div>
                            <button class="btn btn-primary mt-4" type="submit" id="addChildSubmitBtn">Create child account</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('addChildForm')?.addEventListener('submit', function () {
            const btn = document.getElementById('addChildSubmitBtn');
            if (btn && $(this).valid && $(this).valid()) {
                btn.disabled = true;
                btn.textContent = 'Creating account...';
            }
        });
    </script>
}
