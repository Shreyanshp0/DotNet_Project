@model DotNet_Project.ViewModels.ChildCredentialsViewModel
@{
    ViewData["Title"] = Model.IsPasswordReset ? "Password reset complete" : "Child account created";
}
<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="auth-shell">
                    <div class="auth-form w-100">
                        <span class="eyebrow">@(Model.IsPasswordReset ? "Password reset" : "Account created")</span>
                        <h1 class="mt-2">@(Model.IsPasswordReset ? $"New password for {Model.ChildName}" : $"{Model.ChildName}'s account is ready")</h1>
                        <div class="alert alert-warning mt-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Shown once only:</strong> Please copy and securely share these credentials with your child. For security, this temporary password is not stored in plaintext and cannot be viewed again. Your child will be asked to set a new password on their next login.
                        </div>

                        <div class="card border-0 bg-light p-4 mt-3">
                            <div class="mb-3">
                                <div class="small text-muted text-uppercase fw-semibold">Child ID / Username</div>
                                <div class="fs-4 fw-bold font-monospace" id="credChildId">@Model.ChildId</div>
                            </div>
                            <div>
                                <div class="small text-muted text-uppercase fw-semibold">Temporary Password</div>
                                <div class="fs-4 fw-bold font-monospace text-primary" id="credTempPassword">@Model.TemporaryPassword</div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="button" class="btn btn-primary" id="copyCredentialsBtn">
                                <i class="bi bi-clipboard me-1"></i> Copy credentials
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Back to My Children</a>
                        </div>
                        <div id="copyStatus" class="small text-success mt-2 d-none">Credentials copied to clipboard!</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.getElementById('copyCredentialsBtn')?.addEventListener('click', async function () {
            const childId = document.getElementById('credChildId')?.textContent?.trim() ?? '';
            const password = document.getElementById('credTempPassword')?.textContent?.trim() ?? '';
            const text = `MindCare Login\nChild ID: ${childId}\nTemporary Password: ${password}`;
            try {
                await navigator.clipboard.writeText(text);
                document.getElementById('copyStatus')?.classList.remove('d-none');
            } catch {
                alert(text);
            }
        });
    </script>
}
