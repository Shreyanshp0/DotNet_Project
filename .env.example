# ==========================================
# MindCare Environment Variables Template
# Copy this file to .env and fill in values:
# cp .env.example .env
# ==========================================

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Database Configuration (Sqlite or MySql)
DATABASE_PROVIDER=Sqlite
DEFAULT_CONNECTION=Data Source=mindcare.db

# Production MySQL (when DATABASE_PROVIDER=MySql)
MYSQL_CONNECTION=Server=localhost;Port=3306;Database=mindcare_db;User ID=mindcare_app;Password=YOUR_PASSWORD;
